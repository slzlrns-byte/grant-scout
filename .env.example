# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 2단계(본격 분석) 모델. 기본 claude-opus-5
# GRANT_SCOUT_MODEL=claude-opus-5

# 선택: 1단계(목록 기준 걸러내기) 모델. 기본은 GRANT_SCOUT_MODEL 과 같음. 비용을 더 줄이려면 claude-sonnet-5
# GRANT_SCOUT_TRIAGE_MODEL=claude-sonnet-5

# 선택: 상세를 열어 본격 분석하는 후보 상한 (기본 40). 초과분은 '상세 미확인'으로 목록에만 남고 다음 주 재검토
# GRANT_SCOUT_MAX_DETAIL=40

# 선택: 후보당 API로 보내는 공고 본문 글자 수 (기본 900)
# GRANT_SCOUT_BODY_CHARS=900
